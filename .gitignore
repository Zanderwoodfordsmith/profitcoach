# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# cursor (ignore MCP/hooks/local state; keep shared agent rules)
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# local import copies (often nested git repos)
/Import/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# academy import dry-run outputs
/reports/

# ideal client avatar research corpus (member data pulled from Drive)
/.ica-research/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.tmp-frames/
public/membership/*.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Apify actor local deps / run storage
/actors/**/node_modules/
/actors/**/storage/
